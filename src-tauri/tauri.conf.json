{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YT-DLP Deck",
  "version": "1.1.5",
  "identifier": "com.ytdlpdeck.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "YT-DLP Deck",
        "width": 1280,
        "height": 820,
        "minWidth": 560,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost https:",
        "font-src": "'self' data:",
        "frame-src": "https://www.youtube.com https://www.youtube-nocookie.com",
        "img-src": "'self' asset: http://asset.localhost data: blob: https:",
        "media-src": "'self' blob: https:",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "android": {
      "minSdkVersion": 33
    },
    "shortDescription": "Baixe vídeos e áudios com yt-dlp",
    "longDescription": "Interface desktop moderna para yt-dlp e FFmpeg, com instalação automática das ferramentas.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
