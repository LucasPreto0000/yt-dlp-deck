{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YT-DLP Deck",
  "version": "1.1.2",
  "identifier": "com.ytdlpdeck.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "YT-DLP Deck",
        "width": 1280,
        "height": 820,
        "minWidth": 560,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Baixe vídeos e áudios com yt-dlp",
    "longDescription": "Interface desktop moderna para yt-dlp e FFmpeg, com instalação automática das ferramentas.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
